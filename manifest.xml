<?xml version="1.0" encoding="UTF-8"?>
<!--
  Outlook add-in manifest for the out-of-office signature block.

  Do not edit this file by hand. Run Configure-Addin.ps1, which fills in the
  add-in GUID, the Entra client ID and the hosting URL, and writes a ready-to-
  upload copy to dist\ with src/config.js kept in step.

  Permissions: ReadWriteItem is the least privilege that allows
  setSignatureAsync on the message being composed. It grants no access to other
  messages and none to the mailbox at large.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>99e1ad35-3064-46fd-9c31-3aaa0d2947b9</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>DASH Technologies</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Out of Office Signature"/>
  <Description DefaultValue="Adds your upcoming out-of-office days to your email signature, read from your Outlook calendar."/>
  <IconUrl DefaultValue="https://ravee-acharya.github.io/outlook-ooo-signature/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://ravee-acharya.github.io/outlook-ooo-signature/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://ravee-acharya.github.io/outlook-ooo-signature/"/>

  <AppDomains>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
    <AppDomain>https://graph.microsoft.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <!-- 1.10 is the floor: it introduces both setSignatureAsync and
           event-based activation, which this add-in depends on. -->
      <Set Name="Mailbox" MinVersion="1.10"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://ravee-acharya.github.io/outlook-ooo-signature/src/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">

      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">

          <!-- Shared runtime hosting the compose event handler. -->
          <Runtimes>
            <Runtime resid="RuntimeUrl" lifetime="short">
              <Override type="javascript" resid="RuntimeJsUrl"/>
            </Runtime>
          </Runtimes>

          <DesktopFormFactor>
            <FunctionFile resid="RuntimeUrl"/>

            <!-- Task pane button on the reading surface. -->
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="oooGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="oooTaskpaneButton">
                    <Label resid="TaskpaneButtonLabel"/>
                    <Supertip>
                      <Title resid="TaskpaneButtonLabel"/>
                      <Description resid="TaskpaneButtonTip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16"/>
                      <bt:Image size="32" resid="Icon32"/>
                      <bt:Image size="80" resid="Icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="TaskpaneUrl"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- Same button while composing, so settings are reachable there too. -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="oooGroupCompose">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="oooTaskpaneButtonCompose">
                    <Label resid="TaskpaneButtonLabel"/>
                    <Supertip>
                      <Title resid="TaskpaneButtonLabel"/>
                      <Description resid="TaskpaneButtonTip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16"/>
                      <bt:Image size="32" resid="Icon32"/>
                      <bt:Image size="80" resid="Icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="TaskpaneUrl"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- The automation: fires on every new message compose. -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageComposeHandler"/>
              </LaunchEvents>
              <SourceLocation resid="RuntimeUrl"/>
            </ExtensionPoint>

          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon16" DefaultValue="https://ravee-acharya.github.io/outlook-ooo-signature/assets/icon-16.png"/>
          <bt:Image id="Icon32" DefaultValue="https://ravee-acharya.github.io/outlook-ooo-signature/assets/icon-32.png"/>
          <bt:Image id="Icon80" DefaultValue="https://ravee-acharya.github.io/outlook-ooo-signature/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="TaskpaneUrl" DefaultValue="https://ravee-acharya.github.io/outlook-ooo-signature/src/taskpane.html"/>
          <bt:Url id="RuntimeUrl" DefaultValue="https://ravee-acharya.github.io/outlook-ooo-signature/src/commands.html"/>
          <bt:Url id="RuntimeJsUrl" DefaultValue="https://ravee-acharya.github.io/outlook-ooo-signature/src/commands.js"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Out of Office"/>
          <bt:String id="TaskpaneButtonLabel" DefaultValue="OOO Signature"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButtonTip" DefaultValue="Refresh your out-of-office dates and edit your signature."/>
        </bt:LongStrings>
      </Resources>

      <!--
        No <WebApplicationInfo> on purpose.

        That element wires up Office SSO (Office.auth.getAccessToken), which
        returns a token for this add-in's own API - not for Microsoft Graph.
        Exchanging it for a Graph token needs a server-side on-behalf-of call,
        and this add-in has no server by design.

        Tokens come from Nested App Authentication, falling back to an MSAL
        popup, so the registration needs only SPA redirect URIs and delegated
        Graph permissions. Adding WebApplicationInfo here would oblige IT to
        expose an API and pre-authorise Office client IDs for no benefit.
      -->

    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
